POSTGRES_USER=agent_platform
POSTGRES_PASSWORD=changeme
POSTGRES_DB=agent_platform

RABBITMQ_USER=agent_platform
RABBITMQ_PASSWORD=changeme

# Long-lived Claude subscription token for agent containers (`claude setup-token`).
CLAUDE_CODE_OAUTH_TOKEN=

# Git push credentials for agent repo tasks (optional).
# GIT_TOKEN: a personal access token scoped to the test repo (HTTPS push).
# GIT_HOST defaults to github.com if unset.
GIT_TOKEN=
GIT_USER_NAME=
GIT_USER_EMAIL=
GIT_HOST=github.com
